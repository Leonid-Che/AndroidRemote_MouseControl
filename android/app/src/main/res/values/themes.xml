<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TouchCursor" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/btn_pressed</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/bg</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bg</item>
    </style>

    <!-- Общий стиль кнопок нижней панели -->
    <style name="BtnBase">
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:background">@drawable/btn_dark</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="BtnWide" parent="BtnBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="BtnSmall" parent="BtnBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">0.55</item>
    </style>
</resources>
